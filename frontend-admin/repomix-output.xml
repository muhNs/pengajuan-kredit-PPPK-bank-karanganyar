                            style={{ opacity: isVisible ? 1 : 0, transform: isVisible ? 'translateY(0)' : 'translateY(24px)', transitionDelay: `${i * 80}ms` }}
                        >
                            <DocumentCard 
                                label={doc.label} 
                                Icon={doc.Icon} 
                                color={doc.color} 
                                fileData={foundFile} 
